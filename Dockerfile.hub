# ulak-remote (the hub) with the browser UI bundled. Build: docker build -f Dockerfile.hub -t ulak-hub .
FROM rust:1.95-bookworm AS hub-build
WORKDIR /src
COPY . .
RUN cargo build --release -p ulak-remote

FROM rust:1.95-bookworm AS web-build
WORKDIR /src
COPY . .
RUN rustup target add wasm32-unknown-unknown \
 && cargo install wasm-bindgen-cli --locked --version "$(python3 -c 'import tomllib; print(next(p["version"] for p in tomllib.load(open("Cargo.lock","rb"))["package"] if p["name"]=="wasm-bindgen"))')" \
 && scripts/build-web.sh --out /web

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /data ulak \
 && mkdir /data && chown ulak /data
COPY --from=hub-build /src/target/release/ulak-remote /usr/local/bin/ulak-remote
COPY --from=web-build /web /app/web
ENV ULAK_DIR=/data ULAK_WEB_DIR=/app/web ULAK_ADDR=0.0.0.0:8443
USER ulak
VOLUME /data
EXPOSE 8443
ENTRYPOINT ["ulak-remote"]
